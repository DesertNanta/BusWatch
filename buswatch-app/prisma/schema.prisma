// ─────────────────────────────────────────────────────────────────────────────
// BusWatch — Prisma Schema
// Sprint: 002 | Technical Foundation
// Last Updated: 2026-11-13
// ─────────────────────────────────────────────────────────────────────────────
// DESIGN DECISIONS:
//   - UUID primary keys throughout for distributed-safe IDs.
//   - Geospatial fields (geometry) stored as Unsupported("geometry(Point,4326)")
//     because Prisma does not natively support PostGIS types; raw SQL is used
//     for spatial queries via prisma.$queryRaw.
//   - GPS history (gps_positions) is an append-only table; never updated.
//   - vehicle_current_positions is a separate table (not a view) for fast reads.
//     It is upserted each time a new GPS position arrives.
//   - Operator isolation is enforced at service layer (not only FK).
//     All queries must filter by operatorId that matches the authenticated user.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH & RBAC
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String    @db.VarChar(255)
  phone        String?   @db.VarChar(50)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  userRoles    UserRole[]
  operatorUsers OperatorUser[]

  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(50)
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")

  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ─────────────────────────────────────────────────────────────────────────────
// CITY & OPERATOR
// ─────────────────────────────────────────────────────────────────────────────

model City {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(255)
  province    String    @db.VarChar(255)
  country     String    @default("Indonesia") @db.VarChar(100)
  // lat/lng stored separately for Prisma compatibility
  // actual geometry stored via raw SQL: POINT(lng lat) SRID 4326
  lat         Float
  lng         Float
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  cityOperators CityOperator[]
  corridors     Corridor[]
  stops         Stop[]

  @@unique([name, province])
  @@map("cities")
}

model Operator {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(255)
  code         String    @unique @db.VarChar(20)
  contactEmail String?   @map("contact_email") @db.VarChar(255)
  contactPhone String?   @map("contact_phone") @db.VarChar(50)
  address      String?   @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  cityOperators CityOperator[]
  vehicles      Vehicle[]
  corridors     Corridor[]
  operatorUsers OperatorUser[]
  fareRules     FareRule[]

  @@map("operators")
}

// Many-to-many: one city ↔ many operators, one operator ↔ many cities
model CityOperator {
  cityId     String   @map("city_id") @db.Uuid
  operatorId String   @map("operator_id") @db.Uuid
  since      DateTime @default(now())

  city     City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@id([cityId, operatorId])
  @@map("city_operators")
}

// Join table: which users belong to which operator (for authorization)
model OperatorUser {
  operatorId String   @map("operator_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       String   @default("STAFF") @db.VarChar(50) // ADMIN | STAFF | DRIVER
  joinedAt   DateTime @default(now()) @map("joined_at")

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([operatorId, userId])
  @@map("operator_users")
}

// ─────────────────────────────────────────────────────────────────────────────
// TRANSPORT NETWORK
// ─────────────────────────────────────────────────────────────────────────────

// Corridor = named service corridor (e.g. "Koridor 1 Poltrada–Ubung")
// A corridor can have multiple routes (each with a direction)
model Corridor {
  id         String   @id @default(uuid()) @db.Uuid
  cityId     String   @map("city_id") @db.Uuid
  operatorId String   @map("operator_id") @db.Uuid
  name       String   @db.VarChar(255)
  code       String   @db.VarChar(20)
  color      String   @default("#1677f9") @db.VarChar(7)
  description String? @db.Text
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  city     City     @relation(fields: [cityId], references: [id])
  operator Operator @relation(fields: [operatorId], references: [id])
  routes   Route[]

  @@unique([cityId, code])
  @@map("corridors")
}

// Route = a direction of travel within a corridor
// direction: "OUTBOUND" (e.g. Terminal → Airport) | "INBOUND" (Airport → Terminal)
model Route {
  id          String   @id @default(uuid()) @db.Uuid
  corridorId  String   @map("corridor_id") @db.Uuid
  name        String   @db.VarChar(255)
  direction   String   @default("OUTBOUND") @db.VarChar(20)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  corridor   Corridor    @relation(fields: [corridorId], references: [id], onDelete: Cascade)
  routeStops RouteStop[]
  schedules  Schedule[]

  @@map("routes")
}

// Stop = physical bus stop (shared across routes/corridors)
model Stop {
  id       String   @id @default(uuid()) @db.Uuid
  cityId   String   @map("city_id") @db.Uuid
  name     String   @db.VarChar(255)
  code     String?  @db.VarChar(20)
  subtitle String?  @db.VarChar(255)
  lat      Float
  lng      Float
  type     String   @default("BUS_STOP") @db.VarChar(30) // BUS_STOP | TERMINAL | INTERCHANGE
  isActive Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city       City        @relation(fields: [cityId], references: [id])
  routeStops RouteStop[]

  @@map("stops")
}

// RouteStop = ordered stops within a route
// stopOrder: 1 = first stop, 2 = second stop, etc.
model RouteStop {
  routeId     String   @map("route_id") @db.Uuid
  stopId      String   @map("stop_id") @db.Uuid
  stopOrder   Int      @map("stop_order")
  distanceKm  Float?   @map("distance_km") // cumulative distance from route start
  durationMin Int?     @map("duration_min") // expected travel time from start

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop  Stop  @relation(fields: [stopId], references: [id], onDelete: Restrict)

  @@id([routeId, stopId])
  @@unique([routeId, stopOrder])
  @@map("route_stops")
}

// ─────────────────────────────────────────────────────────────────────────────
// FLEET & GPS
// ─────────────────────────────────────────────────────────────────────────────

model Vehicle {
  id           String   @id @default(uuid()) @db.Uuid
  operatorId   String   @map("operator_id") @db.Uuid
  plateNumber  String   @unique @map("plate_number") @db.VarChar(20)
  model        String?  @db.VarChar(100)
  capacity     Int      @default(40)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  operator        Operator               @relation(fields: [operatorId], references: [id])
  gpsDevices      GpsDevice[]
  currentPosition VehicleCurrentPosition?
  occupancy       VehicleOccupancy[]

  @@map("vehicles")
}

model GpsDevice {
  id        String   @id @default(uuid()) @db.Uuid
  vehicleId String   @map("vehicle_id") @db.Uuid
  serial    String   @unique @db.VarChar(100)
  model     String?  @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  gpsPositions GpsPosition[]

  @@map("gps_devices")
}

// GpsPosition = append-only GPS history (never updated, never deleted in normal ops)
// source: ACTUAL (real device) | SIMULATED (test/demo data)
model GpsPosition {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @map("device_id") @db.Uuid
  lat       Float
  lng       Float
  speed     Float?   // km/h
  heading   Float?   // degrees (0–360)
  accuracy  Float?   // metres
  altitude  Float?   // metres
  source    String   @default("ACTUAL") @db.VarChar(20) // ACTUAL | SIMULATED
  quality   String   @default("GOOD") @db.VarChar(20)  // GOOD | DEGRADED | POOR
  timestamp DateTime // device-reported timestamp (may differ from server time)
  createdAt DateTime @default(now()) @map("created_at") // server receipt time

  device GpsDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // Partial index: fast lookups for a device in time range
  @@index([deviceId, timestamp(sort: Desc)])
  @@map("gps_positions")
}

// VehicleCurrentPosition = latest known position for fast UI reads
// Upserted on every new GPS position received; never grows unbounded.
// IMPORTANT: Only update if incoming timestamp > existing timestamp
//            (prevents out-of-order GPS packets from overwriting newer data)
model VehicleCurrentPosition {
  vehicleId     String   @id @map("vehicle_id") @db.Uuid
  lat           Float
  lng           Float
  speed         Float?
  heading       Float?
  source        String   @default("ACTUAL") @db.VarChar(20)
  lastTimestamp DateTime @map("last_timestamp")
  updatedAt     DateTime @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_current_positions")
}

// ─────────────────────────────────────────────────────────────────────────────
// SCHEDULES
// ─────────────────────────────────────────────────────────────────────────────

model Schedule {
  id              String   @id @default(uuid()) @db.Uuid
  routeId         String   @map("route_id") @db.Uuid
  startTime       String   @map("start_time") @db.VarChar(5)  // "05:30"
  endTime         String   @map("end_time") @db.VarChar(5)    // "22:00"
  frequencyMin    Int      @map("frequency_min")               // headway in minutes
  operatingDays   String[] @map("operating_days")             // ["MON","TUE",…,"SUN"]
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@map("schedules")
}

// ─────────────────────────────────────────────────────────────────────────────
// OCCUPANCY
// ─────────────────────────────────────────────────────────────────────────────

// VehicleOccupancy = historical occupancy records (append-only like GPS history)
// primarykey is composite (vehicleId + recordedAt) so duplicates are blocked.
model VehicleOccupancy {
  id            String   @id @default(uuid()) @db.Uuid
  vehicleId     String   @map("vehicle_id") @db.Uuid
  occupancyPct  Float    @map("occupancy_pct") // 0.0 – 100.0
  passengerCount Int?    @map("passenger_count")
  source        String   @default("MANUAL") @db.VarChar(20) // SENSOR | MANUAL | SIMULATED
  recordedAt    DateTime @map("recorded_at")
  createdAt     DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, recordedAt])
  @@index([vehicleId, recordedAt(sort: Desc)])
  @@map("vehicle_occupancy")
}

// ─────────────────────────────────────────────────────────────────────────────
// FARE
// ─────────────────────────────────────────────────────────────────────────────

model FareRule {
  id          String   @id @default(uuid()) @db.Uuid
  cityId      String   @map("city_id") @db.Uuid
  operatorId  String   @map("operator_id") @db.Uuid
  corridorId  String?  @map("corridor_id") @db.Uuid // null = applies to all corridors of operator
  baseFare    Float    @map("base_fare")             // IDR base fare
  perKmRate   Float    @default(0) @map("per_km_rate") // IDR per km (0 = flat fare)
  currency    String   @default("IDR") @db.VarChar(5)
  validFrom   DateTime @map("valid_from")
  validUntil  DateTime? @map("valid_until")           // null = no expiry
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  operator Operator @relation(fields: [operatorId], references: [id])

  @@map("fare_rules")
}
